# mydatama 范例流程环境变量（复制为 .env 后填写；.env 不入库）
BASE_URL=http://localhost:8090
ADMIN_USER=admin
ADMIN_PASS=Admin@123

# 样例数据目录（mydatama-video 生成器产出）：
#   python d:/ProgramData/mytraeprojects/mydatama-video/assets/fixtures/generator/generate_all.py
SAMPLES_DIR=d:/ProgramData/mytraeprojects/mydatama-video/assets/fixtures

# 可选：启用落库层断言（主流程三个 SQL 步骤）
PLATFORM_DSN=host=localhost port=5432 dbname=mydatama user=mydatama password=change_me_in_prod

# 可选：仅反面流程、仅限演示库，用于造数降级触发 R1 红屏
DEMO_TWEAK_DSN=host=localhost port=5432 dbname=mydatama user=mydatama password=change_me_in_prod

# 可选：允许流程声明的 reset 命令（范例未启用 reset）
# ALLOW_RESET=1
